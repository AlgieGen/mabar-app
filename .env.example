# Salin file ini menjadi .env lalu isi SALAH SATU pilihan TURN di bawah.
# TURN membuat voice tetap jalan di jaringan yang tidak bisa tersambung langsung (mis. data seluler).

# Pilihan 1 — Cloudflare Realtime TURN (gratis 1.000 GB/bulan)
# dash.cloudflare.com → Realtime → TURN Server → Create
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Pilihan 2 — Metered Open Relay (gratis 0,5 GB/bulan tanpa kartu)
# dashboard.metered.ca → TURN Server → API key; METERED_APP = nama app (bagian depan .metered.live)
METERED_APP=
METERED_API_KEY=

# Pilihan 3 — server TURN lain
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
